@model EditRestaurantVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Restaurant</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Restaurant.Name" class="control-label"></label>
                <input asp-for="Restaurant.Name" class="form-control" />
                <span asp-validation-for="Restaurant.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Restaurant.TypeKitchenId" class="control-label"></label>
                <select asp-for="Restaurant.TypeKitchenId" class="form-control" asp-items="Model.TypeKitchens"></select>
            </div>
            <div class="form-group">
                <label asp-for="Restaurant.Address" class="control-label"></label>
                <input asp-for="Restaurant.Address" class="form-control" />
                <span asp-validation-for="Restaurant.Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Restaurant.Telephone" class="control-label"></label>
                <input asp-for="Restaurant.Telephone" class="form-control" />
                <span asp-validation-for="Restaurant.Telephone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Restaurant.HourOfWork" class="control-label"></label>
                <input asp-for="Restaurant.HourOfWork" class="form-control" />
                <span asp-validation-for="Restaurant.HourOfWork" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="photo" class="control-label"></label>
                <input type="file" name="photo" id="photo" class="form-control" />
                
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
