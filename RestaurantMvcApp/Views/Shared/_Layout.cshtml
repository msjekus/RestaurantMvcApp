<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet"/>
</head>
<body>
    @{
        string currentPath = Context.Request.Path;
        string fullPath = $"{Context.Request.Path}{Context.Request.QueryString}";
    }
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">Мої улюблені ресторани</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(Url.Action("Index", "Home")==currentPath ? "active" : "")" aria-current="page" asp-action="Index" asp-controller="Home">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Url.Action("Index", "TypeKitchens")==currentPath ? "active" : "")" aria-current="page" asp-action="Index" asp-controller="TypeKitchens">Тип кухні</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Url.Action("Index", "Restaurants")==currentPath ? "active" : "")" aria-current="page" asp-action="Index" asp-controller="Restaurants">Ресторани</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link disabled" aria-disabled="true">Disabled</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        @RenderBody()
    </div>
	<script src="~/lib/bootstrap/js/bootstrap.js"></script>
    @await RenderSectionAsync(name: "Scripts", required: false)
    <div class="container">
        <footer class="py-3 my-4">
            <ul class="nav justify-content-center border-bottom pb-3 mb-3">
                <li class="nav-item"><a asp-action="Index" asp-controller="Home" class="nav-link px-2 text-body-secondary">Home</a></li>
                <li class="nav-item"><a asp-action="Index" asp-controller="TypeKitchens" class="nav-link px-2 text-body-secondary">Тип кухні</a></li>
                <li class="nav-item"><a asp-action="Index" asp-controller="Restaurants" class="nav-link px-2 text-body-secondary">Ресторани</a></li>
                

            </ul>
            <p class="text-center text-body-secondary">© 2025 Company, Inc</p>
        </footer>
    </div>
</body>

</html>
